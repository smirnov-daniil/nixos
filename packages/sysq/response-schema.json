{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "answer": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": ["read-only", "changes-files", "destructive"]
          }
        },
        "required": ["command", "description", "risk"],
        "additionalProperties": false
      }
    },
    "needs_clarification": {
      "type": "boolean"
    }
  },
  "required": ["answer", "commands", "needs_clarification"],
  "additionalProperties": false
}
