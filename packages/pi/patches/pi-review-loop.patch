+    await git(cwd, "config", "user.name", "Test");
+    await writeFile(join(cwd, "app.ts"), "export const value = 1;\n");
+    await git(cwd, "add", ".");
+    await git(cwd, "commit", "-m", "initial");
+    await jj(cwd, "git", "init", "--colocate");
+    await jj(cwd, "new", "-m", "first change");
+    await writeFile(join(cwd, "app.ts"), "export const value = 2;\n");
+    await jj(cwd, "status");
+    await jj(cwd, "new", "-m", "second change");
+    await writeFile(join(cwd, "second.ts"), "export const second = true;\n");
+
+    const current = await scanAgainstCheckpoint(fakePi(), cwd, {
